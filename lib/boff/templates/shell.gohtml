{{ define "boff/shell" }}<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .Title }}</title>
    <!-- Bootstrap only for direct (non-embedded) access: backoffice drops this
         <head> when it embeds the page as a fragment and supplies its own build.
         The bundle is what drives any confirmation dialogs. Nothing this page
         needs may live here: the embedder keeps only #body. -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body>

<div class="container-fluid py-3" id="body">
    <style>
        :root {
            --bo-content-max-width: calc(1920px - 128px);
        }
    </style>
    {{ template "boff/console-style" }}

    {{ .Blocks }}

    <!-- Inside #body, which is the only part backoffice embeds: it parses the
         fetched page server-side and renders #body into its own shell, so a
         script here is parsed by the browser and runs. In the <head> it was
         dropped with the rest of it, which is why payload toggles, copy and the
         severity filter were dead in backoffice. -->
    {{ template "boff/console-script" }}
</div>
</body>
</html>
{{ end }}
