{{ define "block/header" }}
<div class="mb-4">
    <h1 class="h4 mb-1">{{ .Title }}</h1>
    {{ if .Subtitle }}<p class="text-body-secondary small font-monospace mb-0">{{ .Subtitle }}</p>{{ end }}
    {{ if .ErrorMessage }}<div class="alert alert-danger mt-2 mb-0" role="alert">{{ .ErrorMessage }}</div>{{ end }}
</div>
{{ end }}

{{ define "block/card" }}
<div class="card mb-4{{ if .Raised }} shadow-sm{{ end }}">
    <div class="card-body">
        {{ if .Title }}<h5 class="card-title">{{ .Title }}</h5>{{ end }}
        {{ if .Subtitle }}<h6 class="card-subtitle mb-2 text-body-secondary">{{ .Subtitle }}</h6>{{ end }}
        {{ .Body | render }}
    </div>
</div>
{{ end }}

{{ define "block/panel" }}
<div class="card mb-4{{ if .Raised }} shadow-sm{{ end }}">
    {{ range .Children }}{{ . | render }}{{ end }}
</div>
{{ end }}

{{ define "block/summary" }}
<div class="card mb-4 shadow-sm">
    <div class="card-body py-3">
        {{ if .Title }}<h5 class="card-title mb-3">{{ .Title }}</h5>{{ end }}
        <dl class="fact-grid mb-0">
            {{ $card := .Id }}
            {{ range $i, $item := .Facts }}
            <div class="fact mw0">
                <dt class="lbl"{{ if $item.LabelShortened }} title="{{ $item.Label }}"{{ end }}>{{ $item.ShortLabel }}</dt>
                <dd class="text-break{{ if $item.Mono }} font-mono{{ end }}{{ if $item.Muted }} zero{{ end }}">
                    {{ if $item.Tone }}<span class="{{ statusClass $item.Tone }}"><span class="{{ pipClass $item.Tone }}"></span>{{ $item.Value }}</span>
                    {{ else if and $item.Link $item.IsId }}<span class="id-link"><a href="{{ $item.Link }}" class="text-decoration-none" title="{{ $item.Value }}">{{ shortId $item.Value }}</a>{{ template "boff/id-copy" $item.Value }}</span>
                    {{ else if $item.Link }}<a href="{{ $item.Link }}" class="text-decoration-none">{{ $item.Value }}</a>
                    {{ else if $item.IsId }}{{ template "boff/id" $item.Value }}
                    {{ else }}{{ $item.Value }}{{ end }}
                    {{ if $item.FieldCount }}
                    {{ $panel := payload (printf "%s-fact-%d" $card $i) $item.FieldCount $item.JSONHTML true }}
                    {{ template "boff/payload-chip" $panel }}
                    {{ template "boff/payload-panel" $panel }}
                    {{ end }}
                </dd>
            </div>
            {{ end }}
        </dl>
    </div>

    {{ range $i, $item := .Rows }}
    {{ $row := $item.Row }}
    {{ $panel := payload (printf "%s-row-%d" $.Id $i) $item.FieldCount $item.JSONHTML true }}
    <div class="item-row">
        {{ if $row }}
        <span class="{{ pipClass $row.Tone }}"></span>
        <div class="mw0 flex-grow-1">
            <div class="ev-l1">
                <span class="ev-name">{{ $row.Title }}</span>
                {{ if $row.Subtitle }}<span class="ev-desc ell">{{ $row.Subtitle }}</span>{{ end }}
                {{ range $row.Tags }}<span class="badge text-body-secondary border rounded-1 fw-normal item-tag">{{ . }}</span>{{ end }}
                {{ if $row.State }}<span class="{{ statusClass $row.StateTone }} item-state"><span class="{{ pipClass $row.StateTone }}"></span>{{ $row.State }}</span>{{ end }}
                {{ if $item.FieldCount }}{{ template "boff/payload-chip" $panel }}{{ end }}
            </div>
            {{ if $row.Meta }}
            <div class="ev-l2 ell">
                {{ range $m, $part := $row.Meta }}
                {{ if $m }}<span class="sep">&middot;</span>{{ end }}
                {{ if $part.Link }}<a href="{{ $part.Link }}">{{ $part.Text }}</a>{{ else }}<span>{{ $part.Text }}</span>{{ end }}
                {{ end }}
            </div>
            {{ end }}
        </div>
        {{ else }}
        {{/* No structure given: the label heads the row and the value stays as
             the caller wrote it, wrapping rather than being truncated. */}}
        <span class="{{ pipClass $item.Tone }}"></span>
        <div class="mw0 flex-grow-1">
            <div class="d-flex align-items-baseline gap-2 flex-wrap">
                <span class="lbl"{{ if $item.LabelShortened }} title="{{ $item.Label }}"{{ end }}>{{ $item.ShortLabel }}</span>
                {{ if $item.Link }}<a class="item-text text-decoration-none" href="{{ $item.Link }}">{{ $item.Value }}</a>
                {{ else }}<span class="item-text">{{ $item.Value }}</span>{{ end }}
                {{ if $item.FieldCount }}{{ template "boff/payload-chip" $panel }}{{ end }}
            </div>
        </div>
        {{ end }}
    </div>
    {{ if $item.FieldCount }}{{ template "boff/payload-panel" $panel }}{{ end }}
    {{ end }}
</div>
{{ end }}


{{ define "block/actions" }}
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Actions</h5>
        <ul class="list-unstyled mb-0">
            {{ range $i, $a := . }}
            <li class="d-flex align-items-center gap-2{{ if $i }} mt-2{{ end }}">
                {{ if $a.StatusText }}
                    <span class="badge text-bg-secondary">{{ $a.StatusText }}</span>
                {{ else if $a.Link }}
                    <a class="btn btn-sm btn-outline-primary" href="{{ $a.Endpoint }}">{{ $a.ButtonText }}</a>
                {{ else if $a.ConfirmMessage }}
                    <button class="btn btn-sm btn-outline-danger" type="button"
                            data-bs-toggle="modal" data-bs-target="#action-confirm-{{ $i }}">{{ $a.ButtonText }}</button>
                    <div class="modal fade" id="action-confirm-{{ $i }}" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <form class="modal-content" method="POST" action="{{ $a.Endpoint }}">
                                <div class="modal-body">{{ $a.ConfirmMessage }}</div>
                                <div class="modal-footer">
                                    <button class="btn btn-sm btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                                    <button class="btn btn-sm btn-danger" type="submit">{{ with $a.ConfirmText }}{{ . }}{{ else }}OK{{ end }}</button>
                                </div>
                            </form>
                        </div>
                    </div>
                {{ else }}
                    <form method="POST" action="{{ $a.Endpoint }}">
                        <button class="btn btn-sm btn-outline-danger" type="submit">{{ $a.ButtonText }}</button>
                    </form>
                {{ end }}
                <span>{{ $a.Description }}</span>
            </li>
            {{ end }}
        </ul>
    </div>
</div>
{{ end }}

{{ define "overview/filters-form" }}
<form method="GET" class="row row-cols-lg-auto g-2 align-items-end">
    {{ range . }}
    {{ if .Hidden }}
    <input type="hidden" name="{{ .Name }}" value="{{ .Value }}">
    {{ else }}
    <div class="col-12">
        <label class="form-label mb-1" for="filter-{{ .Name }}">{{ .Label }}</label>
        {{ if .Options }}
        <select class="form-select form-select-sm" id="filter-{{ .Name }}" name="{{ .Name }}">
            {{ $selected := .Value }}
            {{ range .Options }}
            <option value="{{ .Value }}"{{ if eq .Value $selected }} selected{{ end }}>{{ .Label }}</option>
            {{ end }}
        </select>
        {{ else }}
        <input class="form-control form-control-sm" type="{{ .InputType }}" id="filter-{{ .Name }}"
               name="{{ .Name }}" value="{{ .Value }}" placeholder="{{ .Placeholder }}">
        {{ end }}
    </div>
    {{ end }}
    {{ end }}
    <div class="col-12">
        <button class="btn btn-sm btn-primary" type="submit">Filter</button>
    </div>
    <div class="col-12">
        <a class="btn btn-sm btn-outline-secondary" href="?">Clear</a>
    </div>
</form>
{{ end }}

{{ define "overview/filters" }}
<div class="mb-3">{{ template "overview/filters-form" . }}</div>
{{ end }}

{{ define "overview/scopenote" }}
<p class="text-body-secondary small mb-3">{{ . }}</p>
{{ end }}

{{ define "overview/table-rows" }}
<table class="table table-hover align-middle mb-0">
    <thead class="table-light">
    <tr>{{ range .Headers }}<th scope="col" class="fw-semibold py-3">{{ . }}</th>{{ end }}</tr>
    </thead>
    <tbody>
    {{ range $row := .Rows }}
    {{ $link := $row.Link }}
    <tr>
        {{ range $i, $text := $row.Cells }}
        {{ $cell := $row.CellAt $i }}
        <td class="py-3">
            {{ if $cell.Link }}<a href="{{ $cell.Link }}">{{ $cell.Text }}</a>
            {{ else if $cell.Tone }}{{ if $link }}<a class="text-reset text-decoration-none" href="{{ $link }}"><span class="badge text-bg-{{ $cell.Tone }}">{{ $cell.Text }}</span></a>{{ else }}<span class="badge text-bg-{{ $cell.Tone }}">{{ $cell.Text }}</span>{{ end }}
            {{ else if $link }}<a class="d-block text-reset text-decoration-none" href="{{ $link }}">{{ $cell.Text }}</a>
            {{ else }}{{ $cell.Text }}{{ end }}
        </td>
        {{ end }}
    </tr>
    {{ else }}
    <tr><td colspan="{{ len .Headers }}" class="text-body-secondary">No records.</td></tr>
    {{ end }}
    </tbody>
</table>
{{ end }}

{{ define "overview/table-flush" }}
<div class="table-responsive">
    {{ template "overview/table-rows" . }}
</div>
{{ end }}

{{ define "overview/filters-card-body" }}
<div class="card-body border-bottom">
    {{ template "overview/filters-form" . }}
</div>
{{ end }}

{{ define "overview/pager" }}
{{ if or .PrevLink .NextLink }}
<nav class="d-flex gap-2 align-items-center my-2">
    {{ if .FirstLink }}<a class="btn btn-sm btn-outline-secondary" href="{{ .FirstLink }}">&laquo; First</a>
    {{ else }}<span class="btn btn-sm btn-outline-secondary disabled">&laquo; First</span>{{ end }}
    {{ if .PrevLink }}<a class="btn btn-sm btn-outline-secondary" href="{{ .PrevLink }}">Previous</a>
    {{ else }}<span class="btn btn-sm btn-outline-secondary disabled">Previous</span>{{ end }}
    <span class="text-body-secondary small">Page {{ .Page }}{{ if .TotalPages }} of {{ .TotalPages }}{{ end }}</span>
    {{ if .NextLink }}<a class="btn btn-sm btn-outline-secondary" href="{{ .NextLink }}">Next</a>
    {{ else }}<span class="btn btn-sm btn-outline-secondary disabled">Next</span>{{ end }}
    {{ if .TotalPages }}
    {{ if .LastLink }}<a class="btn btn-sm btn-outline-secondary" href="{{ .LastLink }}">Last &raquo;</a>
    {{ else }}<span class="btn btn-sm btn-outline-secondary disabled">Last &raquo;</span>{{ end }}
    {{ end }}
</nav>
{{ end }}
{{ end }}
