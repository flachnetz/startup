<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .Title }}</title>
    <!-- Bootstrap only for direct (non-embedded) access: backoffice drops this
         <head> when it embeds the page as a fragment and supplies its own build. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container-fluid py-3">
    <h1 class="h4 mb-1">{{ .Title }}</h1>
    <p class="text-body-secondary small font-monospace">GroupId: {{ .GroupId }}</p>

    {{ if .Summary }}
    <div class="card mb-4">
        <div class="card-body py-2">
            <dl class="row row-cols-1 row-cols-md-2 mb-0 small">
                {{ range .Summary }}
                <div class="col d-flex gap-2 border-bottom py-1">
                    <dt class="fw-semibold text-nowrap" style="min-width:11em">{{ .Label }}</dt>
                    <dd class="mb-0 font-monospace text-break">
                        {{ if .Link }}<a href="{{ .Link }}">{{ .Value }}</a>{{ else }}{{ .Value }}{{ end }}
                    </dd>
                </div>
                {{ end }}
            </dl>
        </div>
    </div>
    {{ end }}

    {{ if .ErrorMessage }}<div class="alert alert-danger" role="alert">{{ .ErrorMessage }}</div>{{ end }}

    {{ if .Actions }}
    <h2 class="h5">Actions</h2>
    <div class="table-responsive mb-4">
        <table class="table table-sm align-middle">
            <thead>
            <tr><th scope="col">Description</th><th scope="col">Action</th></tr>
            </thead>
            <tbody>
            {{ range .Actions }}
            <tr>
                <td>{{ .Description }}</td>
                <td>
                    {{ if .StatusText }}
                        <span class="badge text-bg-secondary">{{ .StatusText }}</span>
                    {{ else if .Link }}
                        <a class="btn btn-sm btn-outline-primary" href="{{ .Endpoint }}">{{ .ButtonText }}</a>
                    {{ else }}
                        <button class="btn btn-sm btn-outline-danger" type="button"
                            data-method="{{ or .Method "POST" }}"
                            data-endpoint="{{ .Endpoint }}"
                            data-confirm="{{ .ConfirmMessage }}">{{ .ButtonText }}</button>
                    {{ end }}
                </td>
            </tr>
            {{ end }}
            </tbody>
        </table>
    </div>
    {{ end }}

    <div class="ledger">
        {{ range .Records }}
            {{ if .ShowSeparator }}<hr class="border-2">{{ end }}
            <div class="border-top py-2">
                <p class="fw-semibold mb-1">{{ .Step }}</p>
                <p class="mb-1">{{ .Description }}</p>
                <p class="text-body-secondary small font-monospace mb-1">{{ formatTime .Timestamp }} &middot; TraceId: {{ .RequestTraceId }} &middot; EventSender: {{ .EventSender }}{{ if .EventSenderVersion }} ({{ .EventSenderVersion }}){{ end }}{{ if .Trigger.Display }} &middot; Source: {{ .Trigger.Display }}{{ end }}</p>
                <details>
                    <summary class="small">payload</summary>
                    <pre class="bg-body-tertiary border rounded p-2 mb-0 small"><code>{{ .JSON }}</code></pre>
                </details>
            </div>
        {{ else }}
            <p class="text-body-secondary">No history records.</p>
        {{ end }}
    </div>
</div>
</body>
</html>
