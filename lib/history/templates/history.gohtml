{{ define "block/records" }}
<div class="d-flex align-items-center flex-wrap gap-2 mb-2">
    <h2 class="h6 mb-0">History</h2>
    {{ if .Traces }}
    <span class="ev-l2">{{ .TraceCount }} trace{{ if ne .TraceCount 1 }}s{{ end }} &middot; {{ .Events }} event{{ if ne .Events 1 }}s{{ end }}{{ if .Duration }} &middot; {{ .Duration }}{{ end }}</span>
    <div class="ms-auto d-flex gap-2">
        {{ if .HasLevels }}
        <select class="form-select form-select-sm w-auto" data-level-filter aria-label="Filter events by severity">
            <option value="">All events</option>
            <option value="warn">Warnings &amp; errors</option>
            <option value="err">Errors only</option>
        </select>
        {{ end }}
        <button class="btn btn-sm btn-outline-secondary" type="button" data-expand-all>Expand payloads</button>
    </div>
    {{ end }}
</div>

<div class="card mb-4 overflow-hidden">
    {{ range .Traces }}
    <div class="trace">
        <div class="trace-head">
            <span class="lbl">Trace</span>
            <span class="tid">{{ template "boff/id" .Id }}</span>
            <span class="sum">{{ .Count }} event{{ if ne .Count 1 }}s{{ end }} &middot; {{ .Duration }} &middot; {{ .Date }}</span>
        </div>
        {{ range .Events }}
        {{ if .FieldCount }}
        {{/* A record with a payload is a <details>: the whole row opens it, the
             browser does the opening (so it works by keyboard and find-in-page
             can reach into a closed payload), and the script only has to
             remember which ones were open. */}}
        <details class="ev-p" data-level="{{ .Level }}" data-payload="{{ .Key }}">
            <summary class="ev">{{ template "history/event" . }}</summary>
            <pre class="payload">{{ .JSONHTML }}</pre>
        </details>
        {{ else }}
        {{/* Nothing to open, so nothing that behaves as if it could be opened. */}}
        <div class="ev" data-level="{{ .Level }}">{{ template "history/event" . }}</div>
        {{ end }}
        {{ end }}
    </div>
    {{ else }}
    <div class="card-body py-3">
        <p class="text-body-secondary mb-0">No history records.</p>
    </div>
    {{ end }}
</div>
{{ end }}

{{/* history/event is the row itself, shared by both shapes above: the same three
     grid columns whether the row can be opened or not. */}}
{{ define "history/event" }}
<span class="ev-t">{{ .TimeOfDay }}<span class="opacity-50">{{ .Millis }}</span></span>
<span class="ev-rail"><span class="{{ pipClass .Level }}"></span></span>
<span class="ev-body">
    <span class="ev-l1">
        <span class="ev-name">{{ .Step }}</span>
        <span class="ev-desc ell">{{ .Description }}</span>
        {{ if .FieldCount }}{{ template "boff/payload-count" .FieldCount }}{{ end }}
    </span>
    <span class="ev-l2 ell">
        <span{{ if .EventSenderVersion }} title="build {{ .EventSenderVersion }}"{{ end }}>{{ .EventSender }}</span>
        {{ if .HTTPSource }}<span class="sep">&middot;</span><span class="font-mono">{{ .HTTPSource }}</span>{{ end }}
        {{ if .SourceRef }}<span class="sep">&middot;</span><span class="font-mono" title="{{ .SourceRefLabel }} {{ .SourceRef }}">{{ .SourceRef }}</span>{{ end }}
        {{ if .ActorId }}<span class="sep">&middot;</span><span class="font-mono" title="{{ .ActorType }} {{ .ActorId }}">{{ .ActorType }} {{ .ActorId }}</span>{{ end }}
    </span>
</span>
{{ end }}
