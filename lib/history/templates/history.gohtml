{{ define "block/records" }}
<div class="ledger">
    {{ range $i, $r := . }}
        {{ if $r.ShowSeparator }}
            </div></div>
            <div class="card mb-3"><div class="card-body py-2">
        {{ else if eq $i 0 }}
            <div class="card mb-3"><div class="card-body py-2">
        {{ end }}
        <div class="py-2{{ if gt $i 0 }}{{ if not $r.ShowSeparator }} border-top{{ end }}{{ end }}">
            <p class="fw-semibold mb-1">{{ $r.Step }}</p>
            <p class="mb-1">{{ $r.Description }}</p>
            <p class="text-body-secondary small font-monospace mb-1">{{ formatTime $r.Timestamp }} &middot; TraceId: {{ $r.RequestTraceId }} &middot; EventSender: {{ $r.EventSender }}{{ if $r.EventSenderVersion }} ({{ $r.EventSenderVersion }}){{ end }}{{ if $r.Trigger.Display }} &middot; Source: {{ $r.Trigger.Display }}{{ end }}</p>
            <details>
                <summary class="small">payload</summary>
                <pre class="bg-body-tertiary border rounded p-2 mb-0 small"><code>{{ $r.JSONHTML }}</code></pre>
            </details>
        </div>
        {{ if eq (add $i 1) (len $) }}</div></div>{{ end }}
    {{ else }}
        <p class="text-body-secondary">No history records.</p>
    {{ end }}
</div>
{{ end }}
