{{ define "block/records" }}
<div class="ledger">
    {{ $collapseAll := .CollapseAll }}
    {{ range $i, $r := .Views }}
        {{ if $r.ShowSeparator }}
            </div></div>
            <div class="card mb-3">
                <div class="card-header py-2 text-body-secondary small font-monospace">TraceId: {{ $r.RequestTraceId }}</div>
                <div class="card-body py-2">
        {{ else if eq $i 0 }}
            <div class="card mb-3">
                <div class="card-header py-2 text-body-secondary small font-monospace">TraceId: {{ $r.RequestTraceId }}</div>
                <div class="card-body py-2">
        {{ end }}
        <div class="py-3{{ if gt $i 0 }}{{ if not $r.ShowSeparator }} border-top{{ end }}{{ end }}">
            <p class="text-body-secondary small font-monospace mb-2">{{ formatTime $r.Timestamp }} &middot; EventSender: {{ $r.EventSender }}{{ if $r.EventSenderVersion }} ({{ $r.EventSenderVersion }}){{ end }}{{ if $r.Trigger.Display }} &middot; Source: {{ $r.Trigger.Display }}{{ end }}</p>
            <p class="fw-semibold mb-1">{{ $r.Step }}</p>
            <p class="text-body-secondary small mb-2">{{ $r.Description }}</p>
            {{ if $r.HasPayload }}
                {{ if or $collapseAll $r.PayloadCollapsible }}
                <details class="mt-1">
                    <summary class="small text-body-secondary">Show full payload</summary>
                    <pre class="bg-body-tertiary border rounded p-2 mt-2 mb-0 small"><code>{{ $r.JSONHTML }}</code></pre>
                </details>
                {{ else }}
                <pre class="bg-body-tertiary border rounded p-2 mt-1 mb-0 small"><code>{{ $r.JSONHTML }}</code></pre>
                {{ end }}
            {{ end }}
        </div>
        {{ if eq (add $i 1) (len $.Views) }}</div></div>{{ end }}
    {{ else }}
        <p class="text-body-secondary">No history records.</p>
    {{ end }}
</div>
{{ end }}
