<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>FailPoints</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <style>
        /* DEV-NOTE: mirrors backoffice/internal/http/assets/static/css/app.css so the
           dev-only failpoints page looks like boff (header + bg-body-tertiary + cards). */
        body {
            min-height: 100vh;
        }

        .bo-header {
            padding: 0 1rem;
        }

        .bo-header-inner {
            display: flex;
            align-items: flex-end;
            gap: 1rem;
            min-height: 3.25rem;
        }

        .bo-brand {
            align-self: center;
            font-weight: 600;
        }

        .bo-nav {
            flex: 1 1 auto;
        }

        .bo-tabs {
            border-bottom: 0;
            margin-bottom: -1px;
        }

        .bo-main {
            display: flex;
            flex-direction: column;
            min-height: 0;
            padding: 1.5rem 1rem;
        }

        .fp-snippet {
            margin: 0;
            white-space: pre-wrap;
            font-size: .8125rem;
        }
    </style>
</head>
<body class="bg-body-tertiary">

<header class="bo-header bg-body border-bottom">
    <div class="bo-header-inner">
        <a class="bo-brand navbar-brand mb-0" href="#">FailPoints</a>
        <nav class="bo-nav">
            <ul class="nav nav-tabs bo-tabs">
                <li class="nav-item"><a class="nav-link active" href="#">Overview</a></li>
            </ul>
        </nav>
        <span class="badge text-bg-warning align-self-center">dev mode</span>
    </div>
</header>

<main class="bo-main">
    <div class="card shadow-sm">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span class="fw-semibold">Fail points</span>
            <code class="text-body-secondary">PUT {{ .UpdateFailPointsEndpoint }}</code>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                <tr>
                    <th scope="col">Location</th>
                    <th scope="col">Error</th>
                    <th scope="col" class="text-center">Active</th>
                    <th scope="col">Filter tags <span class="fw-normal text-body-secondary">(comma separated)</span></th>
                    <th scope="col" class="text-end">Test</th>
                </tr>
                </thead>
                <tbody>
                {{ $failPointsByLocation := .FailPointsByLocation }}
                {{ range $location, $failpoint := .FailPointLocations }}
                    <tr>
                        <td><code class="text-body">{{ $location }}</code></td>
                        <td style="min-width: 18rem;">
                            <select class="form-select form-select-sm" aria-label="Error for {{ $location }}"
                                    id="select__{{ $location }}" onchange="updateFailPoint({{ $location }})">
                                {{ range $fp := index $failPointsByLocation $location }}
                                    <option {{ if eq $fp.ErrorName $failpoint.ErrorName }}selected{{ end }}
                                            value="{{ $fp.ErrorName }}">{{ $fp.ErrorName }}</option>
                                {{ end }}
                            </select>
                        </td>
                        <td class="text-center">
                            <div class="form-check form-switch d-inline-block m-0">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       aria-label="Active for {{ $location }}"
                                       {{ if $failpoint.IsActive }}checked{{ end }}
                                       id="cb__{{ $location }}" onchange="updateFailPoint({{ $location }})">
                            </div>
                        </td>
                        <td style="min-width: 18rem;">
                            <div class="input-group input-group-sm">
                                {{ $filterTags := join $failpoint.FilterTags "," }}
                                <input class="form-control" type="text" id="ft__{{ $location }}"
                                       aria-label="Filter tags for {{ $location }}"
                                       placeholder="none" value="{{ $filterTags }}">
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="updateFailPoint({{ $location }})">Save
                                </button>
                            </div>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary text-nowrap" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#pw__{{ $location }}"
                                    aria-expanded="false">Playwright
                            </button>
                        </td>
                    </tr>
                    <tr class="collapse" id="pw__{{ $location }}">
                        <td colspan="5" class="bg-body-tertiary">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <pre class="fp-snippet" id="snippet__{{ $location }}"></pre>
                                <button class="btn btn-sm btn-outline-secondary text-nowrap" type="button"
                                        onclick="copySnippet({{ $location }})">Copy
                                </button>
                            </div>
                            <div class="form-text mt-2">
                                Arm the fail point from a test before the step that should fail, then disable it again
                                (<code>active: false</code>) so later steps are unaffected.
                            </div>
                        </td>
                    </tr>
                {{ end }}
                </tbody>
            </table>
        </div>
    </div>
</main>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div class="toast align-items-center" id="fp-toast" role="status" aria-live="polite" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="fp-toast-body"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script>
    const updateEndpoint = {{ .UpdateFailPointsEndpoint }};

    function requestBody(codeLocationName) {
        return {
            codeLocationPointName: codeLocationName,
            failPointCode: document.getElementById('select__' + codeLocationName).value,
            active: document.getElementById('cb__' + codeLocationName).checked,
            filterTags: document.getElementById('ft__' + codeLocationName).value
        };
    }

    function toast(message, ok) {
        const el = document.getElementById('fp-toast');
        el.classList.remove('text-bg-success', 'text-bg-danger');
        el.classList.add(ok ? 'text-bg-success' : 'text-bg-danger');
        document.getElementById('fp-toast-body').textContent = message;
        bootstrap.Toast.getOrCreateInstance(el, {delay: 2500}).show();
    }

    // Snippet uses Playwright's request fixture: same PUT the page sends, so a test can
    // arm a fail point without touching this UI.
    function snippet(codeLocationName) {
        const body = requestBody(codeLocationName);
        return "await request.put('" + updateEndpoint + "', {\n"
            + "  data: " + JSON.stringify(body, null, 2).split('\n').join('\n  ') + ",\n"
            + "});";
    }

    function renderSnippet(codeLocationName) {
        const el = document.getElementById('snippet__' + codeLocationName);
        if (el) {
            el.textContent = snippet(codeLocationName);
        }
    }

    function copySnippet(codeLocationName) {
        navigator.clipboard.writeText(snippet(codeLocationName))
            .then(() => toast('Snippet copied', true))
            .catch(err => toast('Copy failed: ' + err, false));
    }

    function updateFailPoint(codeLocationName) {
        fetch(updateEndpoint, {
            method: 'PUT',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(requestBody(codeLocationName)),
        }).then(async response => {
            if (response.ok) {
                toast(codeLocationName + ' updated', true);
            } else {
                toast(codeLocationName + ': ' + response.status + ' ' + (await response.text()).trim(), false);
            }
        }).catch(err => toast(codeLocationName + ': ' + err, false)).finally(() => renderSnippet(codeLocationName));
    }

    document.querySelectorAll('[id^="snippet__"]').forEach(el => renderSnippet(el.id.slice('snippet__'.length)));
</script>
</body>
</html>
